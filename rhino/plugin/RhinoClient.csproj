<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>RhinoClient</AssemblyName>
    <RootNamespace>RhinoClient</RootNamespace>
    <Version>0.1.0</Version>
    <Title>RhinoClient</Title>
    <Description>A dockable Rhino panel with a TypeScript UI.</Description>
    <TargetExt>.rhp</TargetExt>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="Exists('$(ProgramW6432)\Rhino 8\System\Rhino.exe')">
    <StartProgram>$(ProgramW6432)\Rhino 8\System\Rhino.exe</StartProgram>
    <StartArguments>/netcore /nosplash</StartArguments>
    <StartAction>Program</StartAction>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile against the Rhino 8 API; Rhino supplies these assemblies at runtime. -->
    <PackageReference Include="RhinoCommon" Version="8.19.25132.1001" ExcludeAssets="runtime" />
    <EmbeddedResource Include="../panel/dist/panel.host.html" LogicalName="RhinoClient.panel.html" />
    <EmbeddedResource Include="Resources/panel.svg" LogicalName="RhinoClient.panel.svg" />
  </ItemGroup>
  <Target Name="BuildPanel" BeforeTargets="PrepareForBuild">
    <!-- Pass the script path. cmd.exe cannot use this repo's UNC working directory. -->
    <Exec Command="node &quot;$(MSBuildThisFileDirectory)..\panel\build.mjs&quot;" />
  </Target>
</Project>
