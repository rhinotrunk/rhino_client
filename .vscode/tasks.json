{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build RhinoClient",
      "type": "process",
      "command": "node",
      "args": ["scripts/build.mjs"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "preview panel",
      "type": "shell",
      "command": "npm run dev",
      "problemMatcher": []
    }
  ]
}
